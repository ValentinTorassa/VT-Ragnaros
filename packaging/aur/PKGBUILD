# Maintainer: Valentin Torassa <valentintorassacolombero at gmail dot com>
#
# Source of truth for the AUR package.
#
# Before tagging v$pkgver: pkgver here and in .SRCINFO (pkgver and source)
# must equal __version__ in ragnaros/__init__.py, since release.yml refuses a
# tag that differs from it, and pkgrel goes back to 1.
#
# The checksum is the hash of GitHub's tarball of the tag, so it can only be
# filled once the tag is pushed. Then, from the repository root:
#
#   v=0.1.0
#   curl -fsSL -o "/tmp/ragnaros-$v.tar.gz" \
#       "https://github.com/ValentinTorassa/VT-Ragnaros/archive/refs/tags/v$v.tar.gz" &&
#     sum=$(sha256sum "/tmp/ragnaros-$v.tar.gz" | cut -d' ' -f1) &&
#     sed -i "s/^sha256sums=.*/sha256sums=('$sum')/" packaging/aur/PKGBUILD &&
#     sed -i "s/^\tsha256sums = .*/\tsha256sums = $sum/" packaging/aur/.SRCINFO
#
# (on Arch, `updpkgsums && makepkg --printsrcinfo > .SRCINFO` does the same),
# commit both files to main, and copy PKGBUILD, ragnaros.install and .SRCINFO
# into a clone of ssh://aur@aur.archlinux.org/ragnaros.git to push them there.
# `makepkg -f` on Arch builds and tests against the real tarball first.
pkgname=ragnaros
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux driver and daemon for the Ragnaros (Redragon SS552) USB control deck"
arch=('any')
url="https://github.com/ValentinTorassa/VT-Ragnaros"
license=('MIT')
depends=('python' 'python-pillow' 'python-yaml' 'libusb' 'ttf-dejavu')
makedepends=('python-build' 'python-installer' 'python-hatchling')
checkdepends=('python-pytest')
optdepends=('playerctl: media knobs and the now-playing strip'
            'wireplumber: volume and mic keys (wpctl)'
            'brightnessctl: brightness knob'
            'libnotify: pomodoro and OBS notices (notify-send)')
install=ragnaros.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ed7ef64b4b279c069f67080eb74771b95063a91f2db01f0f6ccfdaf33256ff48')

build() {
  cd "VT-Ragnaros-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "VT-Ragnaros-$pkgver"
  python -m pytest -q
}

package() {
  cd "VT-Ragnaros-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 udev/70-ragnaros.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 udev/ragnaros-usbhid.conf -t "$pkgdir/usr/lib/modprobe.d/"
  install -Dm644 packaging/systemd/ragnarosd.service \
    packaging/systemd/ragnaros-gif-refresh.service \
    packaging/systemd/ragnaros-gif-refresh.timer \
    -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
