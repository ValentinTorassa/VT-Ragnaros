#!/usr/bin/env python3
"""Checkout entry point for `ragnarosctl` (install.sh links it into ~/.local/bin)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from ragnaros.ctl import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
